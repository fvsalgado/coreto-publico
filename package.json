{
  "name": "coreto",
  "version": "2.1.0",
  "private": true,
  "description": "Coreto \u2014 agendas culturais regionais: um s\u00f3 c\u00f3digo, uma regi\u00e3o por dom\u00ednio",
  "license": "AGPL-3.0-only",
  "author": "Fábio Salgado (https://salgado.zip)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --filter @coreto/web dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @coreto/web build",
    "lint": "pnpm -r --parallel lint",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ingest": "pnpm --filter @coreto/ingest start",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:a11y:admin": "node scripts/check-a11y-admin.mjs",
    "check:migrations": "./scripts/verify-migrations.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.62.1"
  }
}
