# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# As caches incrementais do eslint e do prettier. Locais por natureza — o que
# lá está descreve os ficheiros desta máquina — e guardadas entre execuções do
# CI pelo `actions/cache`, não pelo Git.
.eslintcache


# Env files — nunca commitar segredos
.env
.env.local
.env.*.local
!.env.example

# Editor
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Vercel
.vercel

# Supabase
supabase/.branches
supabase/.temp
supabase/seed.sql

# Coverage
coverage/
*.lcov

# Dados de execução da ingestão
packages/ingest/.cache/
packages/ingest/data/

# Saída da sondagem das fontes. É obra de terceiros e sai como artefacto.
sondagem/

# Relatório do gitleaks, escrito na área de trabalho quando o varrimento corre.
results.sarif
apps/web/AGENTS.md
apps/web/CLAUDE.md

# Cache do Python: o extrator de fixtures corre como módulo quando se calibra
# um adaptador à mão, e deixa isto para trás.
__pycache__/
*.pyc

# O que o resumo diário lê e escreve na área de trabalho da execução. Sai como
# artefacto, e não tem nada que fazer no repositório — são contagens de um dia.
resumo-*.json
corpo-*.txt

# O processador do MapLibre, copiado do pacote instalado em cada build
# (apps/web/scripts/copiar-maplibre.mjs). Nunca se comete: a versão é a do lockfile.
apps/web/public/maplibre/

# O relatório JSON do Vitest que o CI escreve para o check:numeros
.bateria.json

# O que o CI e os guiões escrevem para se lerem depois, e que se regenera.
# O dossiê contratual é o caso a explicar: a fonte são os seis Markdown em
# `docs/contrato/`, que se revêem em diff e têm asserções; o PDF é o que sai
# deles. Versioná-lo era guardar um binário que muda de data a cada geração e
# que um dia diverge da fonte sem ninguém reparar — e a versão que alguém
# anexou a um processo seria a errada. Gera-se com `pnpm dossie`, e o CI
# publica-o como artefacto descarregável em cada alteração.
estado/

# As permissões locais do Claude Code são de quem trabalha aqui, não do projeto.
.claude/settings.local.json
