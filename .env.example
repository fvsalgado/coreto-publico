# Variáveis de ambiente do Coreto.
#
# Copiar para `.env.local` e preencher o que for preciso. O `.env.local` está
# no `.gitignore` e nunca deve ser versionado; este ficheiro não leva valores
# reais, nem sequer de exemplo.
#
# Quase tudo aqui é facultativo. O sítio tem de compilar, arrancar e servir sem
# base de dados e sem chaves — em CI, num fork, num arranque a frio — e degradar
# em vez de rebentar. Cada bloco diz o que acontece quando falta.
#
# UM AVISO QUE POUPA UMA TARDE: a validação é toda de uma vez. Se UMA variável
# estiver mal formada (um URL sem esquema, uma chave curta de mais), o arranque
# escreve «Configuração inválida» na consola e passa a usar os valores por
# omissão de TODAS — ou seja, o sítio comporta-se como se não houvesse base de
# dados nenhuma. Se as páginas aparecerem subitamente vazias, é a primeira coisa
# a ler nos registos.
#
# Os segredos geram-se em tempo de execução, nunca se inventam à mão:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# O `scripts/provision-supabase.sh` imprime-os todos de uma vez no fim.

# ---------------------------------------------------------------------------
# Sítio
# ---------------------------------------------------------------------------

# Endereço público, sem barra no fim. Entra nos feeds RSS e iCal, no sitemap,
# nos dados estruturados e nos endereços absolutos do widget.
# Em falta: usa-se o endereço que o Vercel atribui ao projeto e, fora do
# Vercel, https://coreto.mediotejo.pt — que é o domínio do projeto e ainda não
# resolve. Em desenvolvimento, isso produz ligações a apontar para fora.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# A região que serve os anfitriões que não estão no mapa de domínios — e, com
# ela, a região principal do deployment (a que herda o NEXT_PUBLIC_SITE_URL
# nos canónicos, nos feeds e no sitemap).
# Em falta: um Host que não é o domínio de nenhuma região vê uma página
# estática sobre o produto, e não a agenda de ninguém — que é o que se quer em
# produção. Mas `localhost` também não é o domínio de nenhuma região: sem esta
# variável, o `pnpm dev` abre nessa página do produto em vez de uma agenda. Em
# desenvolvimento define-se com o identificador da região que se quer ver
# (`medio-tejo`, `vale-do-coreto`, …). Os dois papéis desta variável estão
# separados no código e explicados em docs/VERCEL.md.
REGIAO_DE_OMISSAO=medio-tejo

# ---------------------------------------------------------------------------
# Base de dados (Supabase)
# ---------------------------------------------------------------------------

# Endereço do projeto, na forma https://<ref>.supabase.co
# Em falta: não há catálogo. As listagens ficam vazias, as páginas de concelho
# e de evento respondem 404, os feeds saem sem entradas e o sítio continua a
# compilar e a servir.
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública de leitura (Project Settings → API → anon public). Chega ao
# navegador de quem visita, e é suposto: o que ela pode ler é o que as
# políticas de RLS deixam ler, ou seja, só o que já é público.
# Em falta: o mesmo que acima — sem catálogo.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (Project Settings → API → service_role). Passa por cima do
# RLS. NUNCA a exponhas ao navegador nem lhe ponhas o prefixo NEXT_PUBLIC_.
# Usada pela recolha, pela área de moderação, pela limitação de tráfego e pela
# entrada por email.
# Em falta: o sítio serve em leitura, mas não há moderação, não há submissões,
# não há recolha e a limitação de tráfego deixa passar tudo.
SUPABASE_SERVICE_ROLE_KEY=

# Alternativa a NEXT_PUBLIC_SUPABASE_URL, só para a recolha
# (`packages/ingest`), que corre fora do Next e não tem razão para usar um
# nome com prefixo de cliente. Se as duas estiverem definidas, esta ganha.
SUPABASE_URL=

# ---------------------------------------------------------------------------
# Área de moderação
# ---------------------------------------------------------------------------

# Hash scrypt da palavra-passe da área interna, na forma
# `scrypt$N$r$p$sal$hash`. Gera-se com:
#   printf '%s' 'a-palavra-passe' | pnpm dlx tsx scripts/hash-password.ts
# A palavra-passe em claro não entra em ficheiro nenhum, aqui incluído.
# Em falta: a área interna declara-se por configurar e nenhuma ação de
# moderação corre — as duas variáveis deste bloco são precisas em conjunto.
ADMIN_PASSWORD_HASH=

# Segredo que assina o cookie de sessão da área interna. Mínimo de 32
# caracteres. Mudá-lo termina todas as sessões abertas, que é o que se quer
# quando alguém sai da equipa.
# Em falta: o mesmo que acima — não há sessão possível, e cada ação de
# moderação recusa-se a correr por sua conta, não apenas o guarda da porta.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Segredos de integração
# ---------------------------------------------------------------------------

# Sal usado para transformar o endereço IP num hash antes de o guardar. O
# endereço em si nunca é escrito em lado nenhum. Mínimo de 16 caracteres.
# Em falta: usa-se um valor por omissão conhecido, e nesse caso o hash deixa de
# proteger o que quer que seja. Em produção é obrigatório.
IP_HASH_SALT=

# Segredo do webhook `POST /api/revalidate`, que a recolha e a moderação
# chamam para purgar a cache do sítio. Mínimo de 16 caracteres.
# Em falta: a rota responde 503 e a cache expira sozinha ao fim de uma hora —
# as alterações demoram até uma hora a aparecer, em vez de segundos.
REVALIDATE_SECRET=

# Segredo com que se verifica a assinatura HMAC do webhook de email de entrada
# (`POST /api/intake/email`). Mínimo de 16 caracteres.
# Em falta: a rota recusa tudo com 503. É deliberado — um endereço que aceita
# submissões sem verificar quem as manda é uma fila de moderação inundada.
INBOUND_MAIL_SECRET=

# ---------------------------------------------------------------------------
# Extração de submissões
# ---------------------------------------------------------------------------
#
# Lê um evento a partir do texto de um email, de um PDF ou de um cartaz. Nada
# do que sai daqui é publicado: entra na fila de moderação como tudo o resto e
# é uma pessoa que decide.

# Chave do serviço de extração.
# Em falta: a submissão fica guardada em bruto, com os anexos, e alguém a trata
# à mão. É o caminho de degradação previsto, e funciona.
EXTRACTION_API_KEY=

# Identificador do modelo de extração. Tem valor por omissão no código; só se
# define aqui para o trocar.
EXTRACTION_MODEL=

# Tecto de gasto diário, em milionésimos da unidade monetária (2000000 = 2,00).
# Em falta: assume-se 2000000. A zero, desliga a extração sem tirar a chave.
EXTRACTION_DAILY_BUDGET_MICROS=

# Quantas extrações se fazem por dia ao mesmo remetente. Em falta: 20. Passado
# o limite, os emails continuam a ser guardados; só deixam de ser lidos
# automaticamente.
EXTRACTION_SENDER_DAILY_LIMIT=

# ---------------------------------------------------------------------------
# Medição
# ---------------------------------------------------------------------------
#
# Os contadores por evento (aberturas, cliques na bilhética, calendário,
# partilha) são independentes disto e vivem na base de dados. Estas duas
# variáveis são só para as estatísticas de utilização do sítio.

# Chave de projeto do PostHog. Mínimo de 10 caracteres.
# Em falta: o PostHog não é carregado e não sai daqui um único pedido para lá.
# A política de privacidade acompanha — a página lê esta configuração e deixa
# de o mencionar como subcontratante.
NEXT_PUBLIC_POSTHOG_KEY=

# Servidor do PostHog. Em falta: https://eu.i.posthog.com, ou seja, a União
# Europeia. Mudar isto para fora da UE obriga a rever a política de privacidade
# e o registo de tratamentos em docs/RGPD.md.
NEXT_PUBLIC_POSTHOG_HOST=

# Para onde vão os erros, além do stderr.
#
# Sem ela, `reportarErro` escreve uma linha de JSON nos registos de runtime e
# mais nada — que é o que sempre fez, e o que basta em desenvolvimento. Com
# ela, manda o mesmo objeto por POST para este endereço: serve um ntfy, um
# coletor próprio, ou uma função que reencaminhe para o Sentry. Não há SDK
# nenhum instalado; a costura está em `apps/web/src/lib/registo.ts`.
#
# O que lá vai: o nome da operação, a mensagem, o tipo, a pilha e um contexto
# saneado — sem valores de chaves cujo nome cheire a credencial e com os
# valores longos truncados. Continua a ser um endereço que recebe informação
# sobre falhas internas: guardá-lo como se fosse um segredo, porque é.
ERROS_WEBHOOK_URL=

# MTA-STS: obriga quem entrega correio a este domínio a usar TLS.
#
# Só faz sentido num domínio que RECEBE correio. Em falta, a rota
# /.well-known/mta-sts.txt responde 404 — que é a resposta honesta: não há
# política publicada. Ver docs/DNS.md, que traz também os registos de DNS.
#
# O servidor de correio, ou vários separados por vírgula.
MTA_STS_MX=

# `testing` (omissão) ou `enforce`.
#
# Em `enforce`, um MX mal escrito DEIXA DE RECEBER CORREIO, e a falha é
# silenciosa deste lado — quem escreve é que recebe a devolução. Passa-se a
# `enforce` depois de uma semana a ler os relatórios TLS-RPT, e não antes.
# Sempre que esta política muda, o `id` do registo TXT no DNS tem de mudar
# também, senão os servidores continuam a usar a que têm em cache.
MTA_STS_MODO=

# ---------------------------------------------------------------------------
# Só para os scripts (não são lidas pela aplicação)
# ---------------------------------------------------------------------------

# Ligação direta ao PostgreSQL, usada por `scripts/verify-migrations.sh` e
# `scripts/provision-supabase.sh`. Nunca é usada pelo sítio, que fala com o
# Supabase por HTTP.
# Em falta: `verify-migrations.sh` assume um Postgres local em
# postgres://postgres:postgres@localhost:5432/postgres;
# `provision-supabase.sh` recusa-se a correr.
DATABASE_URL=

# Endereço onde a auditoria de acessibilidade vai bater
# (`pnpm check:a11y`). Em falta: http://127.0.0.1:3000
BASE_URL=

# Caminho para um Chromium já instalado, para a auditoria não descarregar
# centenas de megabytes. Em falta: usa-se o navegador que o Playwright instala.
CHROMIUM_PATH=
